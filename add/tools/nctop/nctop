class SessionsView(View):
    title, keys, every = 'Sessions', 'Enter follow  c closed too  r refresh', 2.0

    def __init__(self, host):
        super().__init__(host)
        self.closed = False
        self.table = Table([('', 5), ('agent', 7), ('where', 22), ('started', 11), ('tool', 16), ('last', 7),
                            ('about', None)])

    def refresh(self):
        rows = []
        for r in session_rows(self.host, self.closed):
            closed = r['s'].get('status') != 'active'
            rows.append((r['s']['id'], [container_cell(r), (r['agent'], 'bold'), (r['where'], 'dim' if closed else None),
                                        (local(r['started']), 'dim'), (tool_cell(r), 'tool'),
                                        (ago(r['last']), fresh(r['last'])), (r['title'], 'accent')], r))
        self.table.set(rows)

    def header(self):
        n = len(self.table.rows)
        live = sum(1 for _, _, r in self.table.rows if r['container'])
        return [L((f'{n} {"" if self.closed else "active "}sessions, {live} with a container', 'dim'))]

    def body(self):
        return self.table

    def key(self, k):
