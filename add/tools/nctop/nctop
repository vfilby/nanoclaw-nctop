STYLE = {}


def init_styles():
    try:
        curses.start_color()
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK
    pairs = {'ok': curses.COLOR_GREEN, 'warn': curses.COLOR_YELLOW, 'bad': curses.COLOR_RED,
             'accent': curses.COLOR_CYAN, 'tool': curses.COLOR_MAGENTA, 'user': curses.COLOR_CYAN,
             'head': curses.COLOR_BLUE}
    for i, (name, fg) in enumerate(pairs.items(), 1):
        try:
            curses.init_pair(i, fg, bg)
            STYLE[name] = curses.color_pair(i)
        except curses.error:
            STYLE[name] = 0
    STYLE['bad'] |= curses.A_BOLD
    STYLE['user'] |= curses.A_BOLD
    STYLE['head'] |= curses.A_BOLD
    STYLE['dim'] = curses.A_DIM
    STYLE['bold'] = curses.A_BOLD


def put(win, y, x, text, attr=0, maxw=None):
    h, w = win.getmaxyx()
    if y < 0 or y >= h or x >= w:
        return x
    room = w - x if maxw is None else min(maxw, w - x)
    text = trunc(text, room) if width(text) > room else text
    try:
        win.addstr(y, x, text, attr)
    except curses.error:
        pass  # the bottom-right cell
    return x + width(text)


def put_segs(win, y, x, segs, maxw, extra=0):
    end = x + maxw
    for text, style in segs:
        if x >= end:
            break
        x = put(win, y, x, text, STYLE.get(style, 0) | extra, end - x)
    return x


class Pager:
    """Scrollable wrapped lines. A followed pager sticks to the bottom until scrolled up, like less +F."""

    def __init__(self, follow=False, followable=False):
        self.lines = []
        self.top = 0
        self.follow = follow
        self.followable = followable or follow
        self.search = None
        self.h = 1
        self._w = None
        self._wrapped = []
        self._n = 0

    def set(self, lines):
        self.lines = lines
        self._w = None

    def append(self, lines):
        self.lines.extend(lines)
        if len(self.lines) > MAX_LINES:
            del self.lines[:len(self.lines) - MAX_LINES]
            self._w = None

    def wrapped(self, w):
        if w != self._w or self._n > len(self.lines):
            self._w, self._wrapped, self._n = w, [], 0
        for segs, ind in self.lines[self._n:]:
            self._wrapped.extend(wrap(segs, w, ind))
        self._n = len(self.lines)
        return self._wrapped

    def draw(self, win, y, h, w):
        self.h = h
        rows = self.wrapped(w)
        bottom = max(0, len(rows) - h)
        if self.follow:
            self.top = bottom
        self.top = min(max(0, self.top), bottom)
        if self.followable and self.top >= bottom and not self.follow and self._scrolled_down:
            self.follow = True
        self._scrolled_down = False
        needle = (self.search or '').lower()
        for i in range(min(h, len(rows) - self.top)):
            segs = rows[self.top + i]
            hit = curses.A_REVERSE if needle and needle in plain(segs).lower() else 0
            put_segs(win, y + i, 0, segs, w, hit)

    _scrolled_down = False

    def scroll(self, n):
        self.top += n
        if n < 0:
            self.follow = False
        else:
            self._scrolled_down = True

    def find(self, term, backwards=False):
        self.search = term or self.search
        if not self.search or self._w is None:
            return False
        rows, needle = self._wrapped, self.search.lower()
        order = range(self.top - 1, -1, -1) if backwards else range(self.top + 1, len(rows))
        for i in order:
            if needle in plain(rows[i]).lower():
                self.top, self.follow = i, False
                return True
        return False

    def key(self, k):
        h = max(1, self.h - 1)
        if k in (curses.KEY_DOWN, ord('j')):
            self.scroll(1)
        elif k in (curses.KEY_UP, ord('k')):
            self.scroll(-1)
        elif k in (curses.KEY_NPAGE, ord(' '), 6):
            self.scroll(h)
        elif k in (curses.KEY_PPAGE, ord('b'), 2):
            self.scroll(-h)
        elif k in (curses.KEY_HOME, ord('g')):
            self.top, self.follow = 0, False
        elif k in (curses.KEY_END, ord('G')):
            self.top = 1 << 30
            self.follow = self.followable
        elif k == ord('f') and self.followable:
            self.follow = not self.follow
        elif k == ord('n'):
            self.find(None)
        elif k == ord('N'):
            self.find(None, backwards=True)
        else:
            return False
        return True


class Table:
    """Rows of cells with a moving selection that survives refreshes (rows are matched by key)."""

    def __init__(self, columns):
        self.columns = columns  # [(title, width)], width None = the rest
        self.rows = []          # [(key, [(text, style)], obj)]
        self.sel = 0
        self.top = 0
        self.h = 1

    def set(self, rows):
        key = self.rows[self.sel][0] if self.rows and self.sel < len(self.rows) else None
        self.rows = rows
        for i, r in enumerate(rows):
            if r[0] == key:
                self.sel = i
                break
        self.sel = min(self.sel, max(0, len(rows) - 1))

    def selected(self):
        return self.rows[self.sel][2] if self.rows else None

    def widths(self, w):
        fixed = sum(cw + 1 for _, cw in self.columns if cw)
        return [cw if cw else max(4, w - fixed) for _, cw in self.columns]

    def draw(self, win, y, h, w):
        ws = self.widths(w)
        x = 0
        for (title, _), cw in zip(self.columns, ws):
            put(win, y, x, pad(title, cw), STYLE['bold'] | curses.A_UNDERLINE)
            x += cw + 1
        h -= 1
        self.h = h
        if self.sel < self.top:
            self.top = self.sel
        if self.sel >= self.top + h:
            self.top = self.sel - h + 1
        for i in range(min(h, len(self.rows) - self.top)):
            j = self.top + i
            _, cells_, _ = self.rows[j]
            rev = curses.A_REVERSE if j == self.sel else 0
            if rev:
                put(win, y + 1 + i, 0, ' ' * w, rev)
            x = 0
            for (text, style), cw in zip(cells_, ws):
                put(win, y + 1 + i, x, pad(text, cw), STYLE.get(style, 0) | rev)
                x += cw + 1
        if not self.rows:
            put(win, y + 1, 0, '(nothing)', STYLE['dim'])

    def key(self, k):
        n = len(self.rows)
        if k in (curses.KEY_DOWN, ord('j')):
            self.sel = min(n - 1, self.sel + 1)
        elif k in (curses.KEY_UP, ord('k')):
            self.sel = max(0, self.sel - 1)
        elif k in (curses.KEY_NPAGE, ord(' '), 6):
            self.sel = min(n - 1, self.sel + max(1, self.h - 1))
        elif k in (curses.KEY_PPAGE, ord('b'), 2):
            self.sel = max(0, self.sel - max(1, self.h - 1))
        elif k in (curses.KEY_HOME, ord('g')):
            self.sel = 0
        elif k in (curses.KEY_END, ord('G')):
            self.sel = max(0, n - 1)
        else:
            return False
        self.sel = max(0, self.sel)
        return True


