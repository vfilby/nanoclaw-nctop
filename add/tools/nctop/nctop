        return True


def list_dir(path, by_time=False):
    try:
        names = os.listdir(path)
    except OSError as e:
        return None, str(e)
    entries = []
    for n in names:
        if HIDDEN.search(n):
            continue
        p = os.path.join(path, n)
        try:
            st = os.lstat(p)
        except OSError:
            continue
        isdir = os.path.isdir(p)
        entries.append({'name': n, 'path': p, 'dir': isdir, 'size': st.st_size,
                        'mtime': dt.datetime.fromtimestamp(st.st_mtime, dt.timezone.utc),
                        'link': os.path.islink(p)})
    if by_time:
        entries.sort(key=lambda e: e['mtime'], reverse=True)
    else:
        entries.sort(key=lambda e: (not e['dir'], e['name'].lower()))
    return entries, None


def file_lines(path):
    if HIDDEN.search(os.path.basename(path)):
        return [L(('hidden (looks like a secret)', 'warn'))]
    try:
        size = os.path.getsize(path)
        with open(path, 'rb') as f:
            data = f.read(MAX_FILE)
    except OSError as e:
        return [L((str(e), 'bad'))]
    if data.startswith(b'SQLite format 3'):
        rows = query(path, "select name from sqlite_master where type = 'table' order by name")
        return [L((f'SQLite database, {human_bytes(size)}; tables:', 'dim'))] + [L('  ' + r['name']) for r in rows]
    if b'\0' in data[:8192]:
        return [L((f'binary file, {human_bytes(size)}', 'dim'))]
    text = data.decode('utf-8', 'replace')
    if path.endswith('.json'):
        try:
            text = json.dumps(json.loads(text), indent=2, ensure_ascii=False)
        except ValueError:
            pass
    lines = text_lines(text)
    if size > MAX_FILE:
        lines.append(L((f'… truncated at {human_bytes(MAX_FILE)} of {human_bytes(size)}', 'warn')))
    return lines


class FilesView(View):
    keys = 'Enter open  ← up  s sort name/time'
    every = 3.0

    def __init__(self, host, root=GROUPS_DIR):
        super().__init__(host)
        self.root = os.path.realpath(root)
        self.cwd = self.root
        self.by_time = False
        self.error = None
        self.table = Table([('name', None), ('size', 8), ('modified', 12)])

    @property
    def title(self):
        return 'Files'

    def refresh(self):
        entries, self.error = list_dir(self.cwd, self.by_time)
        rows = []
        for e in entries or []:
            name = e['name'] + ('/' if e['dir'] else '') + (' @' if e['link'] else '')
            rows.append((e['path'], [(name, 'accent' if e['dir'] else None),
                                     ('' if e['dir'] else human_bytes(e['size']), 'dim'),
                                     (local(e['mtime']), fresh(e['mtime']))], e))
        self.table.set(rows)

    def header(self):
        rel = os.path.relpath(self.cwd, ROOT) if self.cwd.startswith(ROOT) else self.cwd
        return [L((rel + '/', 'bold'), (f'  sorted by {"time" if self.by_time else "name"}', 'dim'),
                  (f'  {self.error}' if self.error else '', 'bad'))]

    def body(self):
        return self.table

    def go(self, path):
        real = os.path.realpath(path)
        if real == self.root or real.startswith(self.root + os.sep):  # never climb out of the root, even by symlink
            self.cwd = real
            self.table.sel = self.table.top = 0
            self.next = 0
            return True
        return False

    def key(self, k):
        e = self.table.selected()
        if k in ENTER + (curses.KEY_RIGHT, ord('l')) and e:
            if e['dir']:
                self.go(e['path'])
                return True
            real = os.path.realpath(e['path'])
            if real.startswith(self.root + os.sep):
                return ('push', FileView(self.host, real))
            return True
        if k in BACK:
            if self.cwd != self.root:
                prev = self.cwd
                self.go(os.path.dirname(self.cwd))
                self.refresh()
                for i, r in enumerate(self.table.rows):
                    if os.path.realpath(r[0]) == prev:
                        self.table.sel = i
                return True
            return False
        if k == ord('s'):
            self.by_time = not self.by_time
            self.next = 0
            return True
        return self.table.key(k)


class FileView(View):
    title, keys, every = 'File', '/ search  n/N next/prev  (reloads when the file changes)', 2.0

    def __init__(self, host, path):
