class View:
    title = ''
    keys = ''
    every = 2.0  # seconds between refreshes

    def __init__(self, host):
        self.host = host
        self.next = 0

    def tick(self):
        if time.time() >= self.next:
            self.next = time.time() + self.every
            self.refresh()

    def refresh(self):
        pass

    def header(self):
        return []

    def body(self):
        raise NotImplementedError

    def draw(self, win, y, h, w):
        head = self.header()
        for i, line in enumerate(head[:max(0, h - 2)]):
            put_segs(win, y + i, 0, line[0], w)
        n = min(len(head), max(0, h - 2))
        self.body().draw(win, y + n, h - n, w)

    def key(self, k):
        return self.body().key(k)

    def search(self, term):
        b = self.body()
        if isinstance(b, Pager):
            b.find(term)


