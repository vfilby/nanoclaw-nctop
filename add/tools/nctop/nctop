from contextlib import closing


def install_root():
    env = os.environ.get('NANOCLAW_DIR')
    if env:
        return os.path.abspath(env)
    return os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))


ROOT = install_root()
DATA = os.path.join(ROOT, 'data')
SESSIONS_DIR = os.path.join(DATA, 'v2-sessions')
GROUPS_DIR = os.path.join(ROOT, 'groups')
LOG_DIR = os.path.join(ROOT, 'logs')
NCL = os.environ.get('NCTOP_NCL') or os.path.join(ROOT, 'bin', 'ncl')
RUNTIME = os.environ.get('CONTAINER_RUNTIME') or 'docker'
# The install slug (sha1 of the project root, as setup/lib/install-slug.sh) names the service and the containers.
SLUG = hashlib.sha1(ROOT.encode()).hexdigest()[:8]
SYSTEMD_UNIT = f'nanoclaw-v2-{SLUG}.service'
LAUNCHD_LABEL = f'com.nanoclaw-v2-{SLUG}'
CONTAINER_PREFIX = f'ncl-{SLUG}-'


def container_name(session_id):
    """A session's agent container, named as the docker driver's agentContainerName() does."""
    raw = re.sub(r'[^a-zA-Z0-9_.-]', '-', f'{SLUG}-{session_id}')
    if len(raw) <= 48:
        return f'ncl-{raw}'
    digest = hashlib.sha256(f'{SLUG}\0{session_id}'.encode()).hexdigest()[:8]
    return f'ncl-{raw[:39]}-{digest}'

# The file browser never lists or opens these, in any folder: an agent can write anything into its own folder.
HIDDEN = re.compile(r'^\.(env|ssh|gnupg|netrc|aws|docker)\b|^id_|\.(pem|key|p12|pfx|kdbx)$|token|secret|credential|passw',
                    re.I)
MAX_FILE = 4 << 20        # bytes of one file shown
MAX_TRANSCRIPT = 8 << 20  # bytes of a transcript read on open (its tail)
MAX_LOG = 1 << 20         # bytes of a log read on open (its tail)
MAX_LINES = 20000         # logical lines a followed pager keeps

PROBLEMS = {}  # what failed last time (key -> message), shown on the overview


def owner_hint():
    """A problem line when this user is not the one the install belongs to (transcripts would be unreadable)."""
    try:
        owner = os.stat(DATA).st_uid
    except OSError:
        PROBLEMS['root'] = f'{ROOT} has no data/ directory: run nctop from a NanoClaw checkout or set NANOCLAW_DIR'
        return
    if owner != os.geteuid():
        try:
            import pwd
            name = pwd.getpwuid(owner).pw_name
        except (ImportError, KeyError):
            name = str(owner)
        PROBLEMS['owner'] = f'the install belongs to {name}; run as that user (sudo -u {name} {sys.argv[0]})'


# ---- text ---------------------------------------------------------------------------------------------------------
# A line is (segments, indent): segments are (text, style) pairs, indent is where wrapped continuations start.

ANSI = re.compile(r'\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b[@-Z\\-_]')
CTRL = re.compile(r'[\x00-\x08\x0b-\x1f\x7f]')


def clean(s):
    return CTRL.sub('', ANSI.sub('', str(s)).replace('\t', '    ').replace('\r', ''))


def cells(c):
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in 'WF' else 1


def width(s):
    return sum(cells(c) for c in s)


def trunc(s, w):
    if w <= 0:
        return ''
    s = clean(s).replace('\n', ' ')
    if width(s) <= w:
        return s
    out, n = [], 0
    for c in s:
        k = cells(c)
        if n + k > w - 1:
            break
        out.append(c)
        n += k
    return ''.join(out) + '…'


def pad(s, w):
    s = trunc(s, w)
    return s + ' ' * (w - width(s))


def L(*parts, indent=0):
    return [p if isinstance(p, tuple) else (p, None) for p in parts], indent


def text_lines(text, style=None, prefix=(), indent=None):
    """Multi-line text: the prefix segments lead the first line, later lines line up under the text."""
    prefix = [p if isinstance(p, tuple) else (p, None) for p in prefix]
    ind = width(''.join(t for t, _ in prefix)) if indent is None else indent
    out = []
    for i, ln in enumerate(clean(text).split('\n')):
        segs = list(prefix) if i == 0 else [(' ' * ind, None)]
        segs.append((ln, style))
        out.append((segs, ind))
    return out


def plain(segs):
    return ''.join(t for t, _ in segs)


def wrap(segs, w, indent=0):
    if w <= 0:
        return [[]]
    indent = min(indent, w // 2)
    rows, cur, n = [], [], 0
    for text, style in segs:
        buf = []
        for c in text:
            k = cells(c)
            if n + k > w:
                if buf:
                    cur.append((''.join(buf), style))
                    buf = []
                rows.append(cur)
                cur, n = ([(' ' * indent, None)], indent) if indent else ([], 0)
            buf.append(c)
            n += k
        if buf:
            cur.append((''.join(buf), style))
    rows.append(cur)
    return rows


def first_lines(text, n):
    lines = clean(text).strip('\n').split('\n')
    return '\n'.join(lines[:n]), max(0, len(lines) - n)


def last_lines(text, n):
    lines = clean(text).strip('\n').split('\n')
    return '\n'.join(lines[-n:]), max(0, len(lines) - n)


def compact(obj, drop=('requestId',)):
    if isinstance(obj, dict):
        obj = {k: v for k, v in obj.items() if k not in drop}
    return json.dumps(obj, ensure_ascii=False, separators=(',', ':'))


def human_bytes(n):
    try:
        n = float(n)
    except (TypeError, ValueError):
        return '-'
    for unit in ('B', 'K', 'M', 'G', 'T'):
        if n < 1024 or unit == 'T':
            return f'{n:.0f}{unit}' if unit == 'B' else f'{n:.1f}{unit}'
        n /= 1024


# ---- time ---------------------------------------------------------------------------------------------------------

def parse_ts(s):
    if not s:
        return None
    try:
        t = dt.datetime.fromisoformat(str(s).replace('Z', '+00:00'))
    except ValueError:
        return None
    return t if t.tzinfo else t.replace(tzinfo=dt.timezone.utc)


def now_utc():
    return dt.datetime.now(dt.timezone.utc)


def span(seconds):
    s = int(abs(seconds))
    if s < 60:
        return f'{s}s'
    if s < 3600:
        return f'{s // 60}m'
    if s < 86400:
        return f'{s // 3600}h{(s % 3600) // 60:02d}m'
    return f'{s // 86400}d{(s % 86400) // 3600}h'


def ago(t):
    if t is None:
        return '-'
    d = (now_utc() - t).total_seconds()
    return f'in {span(d)}' if d < 0 else span(d)


def local(t, fmt='%m-%d %H:%M'):
    return t.astimezone().strftime(fmt) if t else '-'


def fresh(t):
    if t is None:
        return 'dim'
    d = (now_utc() - t).total_seconds()
    return 'ok' if d < 900 else 'warn' if d < 7200 else 'dim'


# ---- reading --------------------------------------------------------------------------------------------------------

def query(path, sql, args=()):
    """Rows from a session mailbox DB, read-only; [] when it is missing or busy (the next refresh tries again)."""
    if not os.path.exists(path):
        return []
    try:
        uri = 'file:' + urllib.parse.quote(path) + '?mode=ro'
        with closing(sqlite3.connect(uri, uri=True, timeout=0.5)) as c:
            c.row_factory = sqlite3.Row
            return [dict(r) for r in c.execute(sql, args)]
    except sqlite3.Error:
        return []


def run(argv, timeout=8, cwd=None):
    key = ' '.join(os.path.basename(a) if i == 0 else a for i, a in enumerate(argv[:3]))
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, cwd=cwd, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError) as e:
        PROBLEMS[key] = f'{key}: {e}'
        return None
    if p.returncode:
        PROBLEMS[key] = f'{key}: exit {p.returncode} {clean(p.stderr).strip()[:200]}'
        return None
    PROBLEMS.pop(key, None)
    return p.stdout


def ncl(resource, *args, timeout=20):
    """`ncl <resource> list --json`'s rows, or None when ncl failed (the reason goes to PROBLEMS)."""
    key = f'ncl {resource} list'
    out = run([NCL, resource, 'list', *args, '--json'], cwd=ROOT, timeout=timeout)
    if out is None:
        return None
    try:
        frame = json.loads(out[out.find('{'):])
    except ValueError:
        PROBLEMS[key] = f'{key}: not JSON'
        return None
    if not frame.get('ok'):
        PROBLEMS[key] = f"{key}: {(frame.get('error') or {}).get('message', 'failed')}"
        return None
    return frame.get('data') or []


def service_state():
    if sys.platform == 'darwin':
        d = {'unit': LAUNCHD_LABEL, 'missing': True}
        for ln in (run(['launchctl', 'list']) or '').splitlines():
            parts = ln.split('\t')
            if len(parts) == 3 and parts[2] == LAUNCHD_LABEL:
                running = parts[0] not in ('-', '')
                d.update(missing=False, ActiveState='active' if running else 'inactive',
                         SubState='running' if running else f'last exit {parts[1]}', MainPID=parts[0] if running else '')
        return d
    out = run(['systemctl', '--user', 'show', SYSTEMD_UNIT, '--timestamp=unix',
               '-p', 'LoadState,ActiveState,SubState,ActiveEnterTimestamp,MainPID,NRestarts,MemoryCurrent'])
    d = {'unit': SYSTEMD_UNIT}
    for ln in (out or '').splitlines():
        k, _, v = ln.partition('=')
        d[k] = v
    d['missing'] = out is None or d.get('LoadState') == 'not-found'
    return d


def json_lines(out):
    rows = []
    for ln in (out or '').splitlines():
        try:
            rows.append(json.loads(ln))
        except ValueError:
            pass
    return rows


def docker_ps():
    out = run([RUNTIME, 'ps', '--format', '{{json .}}'])
    return None if out is None else json_lines(out)


def docker_stats():
    out = run([RUNTIME, 'stats', '--no-stream', '--format', '{{json .}}'], timeout=20)
    return {r.get('Name'): r for r in json_lines(out)}


def host_stats():
    d = {'name': socket.gethostname()}
    try:
        d['load'] = ['%.2f' % x for x in os.getloadavg()]
    except OSError:
        pass
    try:
        with open('/proc/uptime') as f:
            d['uptime'] = float(f.read().split()[0])
        mem = {}
        with open('/proc/meminfo') as f:
            for ln in f:
                k, _, v = ln.partition(':')
                mem[k] = int(v.split()[0]) * 1024
        d['mem'] = (mem['MemTotal'] - mem.get('MemAvailable', 0), mem['MemTotal'])
    except (OSError, KeyError, ValueError, IndexError):
        pass  # not Linux
    try:
        u = shutil.disk_usage(ROOT)
        d['disk'] = (u.used, u.total)
    except OSError:
        pass
    return d


class Host:
    """What the views read. ncl and the service/container commands run in a background thread (in parallel: each
    takes a few hundred ms); the views read the latest results. Session mailboxes are read on demand."""

    FAST = {'groups': (), 'sessions': ('--limit', '5000'), 'messaging-groups': (), 'user-dms': (), 'users': (),
            'approvals': ()}
    SLOW = {'tasks': (), 'dropped-messages': ()}

    def __init__(self):
        self.data = {}
        self.service = None
        self.containers = None
        self.stats = {}
        self.refreshed = None
        self._wake = threading.Event()

    def refresh(self, slow=True):
        jobs = dict(self.FAST, **(self.SLOW if slow else {}))
        with ThreadPoolExecutor(max_workers=len(jobs) + 3) as pool:
            rows = {r: pool.submit(ncl, r, *a) for r, a in jobs.items()}
            service = pool.submit(service_state)
            containers = pool.submit(docker_ps)
            stats = pool.submit(docker_stats)
            for r, f in rows.items():
                self.data[r] = f.result()
            self.service = service.result()
            self.containers = containers.result()
            self.stats = stats.result() if self.containers is not None else {}
        self.refreshed = time.time()

    def start(self):
        def loop():
            last_slow = 0
            while True:
                due = time.time() - last_slow > 30
                try:
                    self.refresh(slow=due)
                except Exception as e:  # keep the loop alive; the overview shows it
                    PROBLEMS['refresh'] = f'refresh: {e!r}'
                if due:
                    last_slow = time.time()
                if self._wake.wait(5):
                    self._wake.clear()
                    last_slow = 0
        threading.Thread(target=loop, daemon=True).start()

    def poke(self):
        self._wake.set()

    def rows(self, resource):
        return self.data.get(resource) or []

    @property
    def tasks(self):
        return self.data.get('tasks')

    def groups(self):
        return {g['id']: g for g in sorted(self.rows('groups'), key=lambda g: g.get('name') or '')}

    def messaging_groups(self):
        return {m['id']: m for m in self.rows('messaging-groups')}

    def dm_names(self):
        names = {u['id']: u.get('display_name') for u in self.rows('users')}
        return {d['messaging_group_id']: names[d['user_id']] for d in self.rows('user-dms') if names.get(d['user_id'])}

    def sessions(self):
        return sorted(self.rows('sessions'), key=lambda s: s.get('last_active') or '', reverse=True)

    def approvals(self):
        return sorted(self.rows('approvals'), key=lambda a: a.get('created_at') or '')

    def dropped(self, hours=24):
        cutoff = now_utc() - dt.timedelta(hours=hours)
        return [d for d in self.rows('dropped-messages') if (parse_ts(d.get('last_seen')) or cutoff) > cutoff]


# ---- sessions -------------------------------------------------------------------------------------------------------

def sess_dir(s):
    return os.path.join(SESSIONS_DIR, s['agent_group_id'], s['id'])


def sess_db(s, name, sql, args=()):
    return query(os.path.join(sess_dir(s), name), sql, args)


def sess_state(s):
    st = {r['key']: r['value'] for r in sess_db(s, 'outbound.db', 'select key, value from session_state')}
    cs = sess_db(s, 'outbound.db', 'select current_tool, tool_started_at from container_state where id = 1')
    if cs:
        st.update(cs[0])
    try:
        st['heartbeat'] = dt.datetime.fromtimestamp(os.path.getmtime(os.path.join(sess_dir(s), '.heartbeat')),
                                                    dt.timezone.utc)
    except OSError:
        pass
    return st


_transcripts = {}


def transcript_path(s, st):
    cid = st.get('continuation:claude')
    if not cid:
        return None
    p = _transcripts.get(cid)
    if p and os.path.exists(p):
        return p
    hits = glob.glob(os.path.join(glob.escape(os.path.join(SESSIONS_DIR, s['agent_group_id'])), '.claude-shared',
                                  'projects', '*', glob.escape(cid) + '.jsonl'))
    p = max(hits, key=os.path.getmtime) if hits else None
    if p:
        _transcripts[cid] = p
    return p


_titles = {}


def transcript_title(path):
    """The newest ai-title line in the transcript's tail (Claude Code rewrites it as the conversation moves on)."""
    try:
        size = os.path.getsize(path)
    except OSError:
        return None
    hit = _titles.get(path)
    if hit and hit[0] == size:
        return hit[1]
    title = hit[1] if hit else None
    with open(path, 'rb') as f:
        f.seek(max(0, size - (256 << 10)))
        tail = f.read()
    for ln in reversed(tail.split(b'\n')):
        if b'"ai-title"' in ln:
            try:
                title = json.loads(ln).get('aiTitle') or title
                break
            except ValueError:
                continue
    _titles[path] = (size, title)
    return title


_openers = {}


def first_message(s):
    if s['id'] in _openers:
        return _openers[s['id']]
    rows = sess_db(s, 'inbound.db', "select kind, content from messages_in where kind in ('chat-sdk', 'chat', 'task') "
                                     "order by seq limit 1")
    text = None
    if rows:
        c = loads(rows[0]['content'])
        if isinstance(c, dict):
            text = c.get('text') or c.get('prompt')
        if text:  # its first line only: a pasted email or ticket can carry anything
            text = trunc(text.strip().split('\n')[0], 200)
            _openers[s['id']] = text
    return text


def where(s, mgs, dms):
    mg = mgs.get(s.get('messaging_group_id') or '')
    tid = s.get('thread_id') or ''
    if not mg:
        if tid.startswith('system:tasks:'):
            return 'task ' + tid.split(':', 2)[2]
        return 'internal'
    name = mg.get('name')
    if mg.get('is_group'):
        label = '#' + (name or mg.get('platform_id') or '?')
    elif mg.get('channel_type') == 'email' or (name and 'DM' in name):
        label = name or mg.get('platform_id') or '?'
    else:
        label = 'DM ' + (dms.get(mg['id']) or name or mg.get('platform_id') or '?')
    if mg.get('channel_type') not in ('slack', 'email'):
        label = f"{mg.get('channel_type')}: {label}"
    return label


def thread_started(s):
    m = re.search(r':(\d{9,}\.\d+)$', s.get('thread_id') or '')
    if m:
        return dt.datetime.fromtimestamp(float(m.group(1)), dt.timezone.utc)
    return parse_ts(s.get('created_at'))


def session_containers(containers):
    """Running containers by name."""
    return {c.get('Names', ''): c for c in containers or []}


def session_rows(host, include_closed=False):
    groups, mgs, dms = host.groups(), host.messaging_groups(), host.dm_names()
    live = session_containers(host.containers)
    rows = []
    for s in host.sessions():
        if s.get('status') != 'active' and not include_closed:
            continue
        st = sess_state(s)
        tpath = transcript_path(s, st)
        g = groups.get(s['agent_group_id'], {})
        rows.append({
            's': s, 'st': st, 'tpath': tpath,
            'agent': g.get('name') or s['agent_group_id'], 'folder': g.get('folder'),
            'where': where(s, mgs, dms), 'started': thread_started(s),
            'last': parse_ts(s.get('last_active')), 'container': live.get(container_name(s['id'])),
            'title': (transcript_title(tpath) if tpath else None) or first_message(s) or '',
        })
    return rows


def container_cell(r):
    """(text, style) for a session's container: what docker says, flagged when the DB disagrees."""
    db = r['s'].get('container_status')
    if r['container']:
        return '● run', 'ok'
    if db == 'running':
        return '? run', 'warn'  # the DB thinks so, docker has no container
    return '○', 'dim'


def tool_cell(r):
    st = r['st']
    tool = st.get('current_tool')
    if not tool:
        return ''
    t = parse_ts(st.get('tool_started_at'))
    return f'{short_tool(tool)} {span((now_utc() - t).total_seconds())}' if t else short_tool(tool)


def short_tool(name):
    m = re.match(r'mcp__(.+?)__(.+)$', name or '')
    if not m:
        return name or ''
    return m.group(2) if m.group(1) == 'nanoclaw' else f'{m.group(1)}:{m.group(2)}'


# ---- rendering: messages ------------------------------------------------------------------------------------------

def loads(s):
    try:
        return json.loads(s)
    except (TypeError, ValueError):
        return s


def brief_result(c):
    res = c.get('result')
    if isinstance(res, dict):
        for k in ('text', 'output', 'response', 'error'):
            if isinstance(res.get(k), str) and res[k].strip():
                return res[k]
        return compact(res)
    if c.get('error'):
        return str(c['error'])
    if c.get('frame') is not None:
        return compact(c['frame'])
    return compact(c)


def brief_action(c, verbose):
    a = c.get('action')
    if a == 'send_email' and not verbose:
        to = ', '.join(c.get('to') or [])
        return f'to {to}: "{c.get("subject", "")}"'
    if a in ('ops_run', 'ops_check'):
        bits = [c.get('host'), c.get('tier'), c.get('check'), c.get('command') or c.get('query')]
        return ' '.join(str(b) for b in bits if b) + (f'  ({c["reason"]})' if c.get('reason') and verbose else '')
    return compact({k: v for k, v in c.items() if k != 'action'})


def message_lines(direction, r, verbose=False):
    t = parse_ts(r.get('timestamp'))
    when = (local(t, '%m-%d %H:%M:%S') + ' ', 'dim')
    c = loads(r.get('content'))
    kind = r.get('kind')
    if not isinstance(c, dict):
        return text_lines(str(c), None, prefix=[when, (f'{direction} {kind}: ', 'dim')])
    if direction == 'in':
        status = r.get('status')
        flag = [] if status in (None, 'completed') else [(f'[{status}] ', 'warn' if status == 'pending' else 'bad')]
        if kind in ('chat-sdk', 'chat'):
            who = c.get('senderName') or c.get('sender') or (c.get('author') or {}).get('fullName') or '?'
            text = c.get('text') or ''
            if c.get('attachments'):
                text += f'  [{len(c["attachments"])} attachment(s)]'
            return text_lines(text, None, prefix=[when, *flag, (f'» {who}: ', 'user')])
        if kind == 'task':
            return text_lines(c.get('prompt') or compact(c), 'warn', prefix=[when, *flag, ('⏰ task: ', 'warn')])
        if kind == 'system':
            label = c.get('type') or 'system'
            body = brief_result(c)
            if not verbose:
                body, more = first_lines(body, 3)
                body += f'\n… {more} more lines' if more else ''
            style = 'bad' if c.get('status') not in (None, 'ok') else 'dim'
            return text_lines(body, 'dim', prefix=[when, *flag, (f'  ⎿ {label} {c.get("status") or ""}: ', style)])
        return text_lines(compact(c), 'dim', prefix=[when, *flag, (f'in {kind}: ', 'dim')])
    # outbound
    if kind == 'chat':
        return text_lines(c.get('text') or compact(c), None, prefix=[when, ('● ', 'ok')])
    if kind == 'task_log':
        return text_lines(c.get('text') or compact(c), 'dim', prefix=[when, ('task log: ', 'dim')])
    if kind == 'system':
        if c.get('action') == 'set_status':
            return text_lines(c.get('text') or '', 'dim', prefix=[when, ('  … ', 'dim')])
        body = brief_action(c, verbose)
        if not verbose:
            body = trunc(body, 240)
        return text_lines(body, None, prefix=[when, (f'⚙ {c.get("action") or "system"} ', 'tool')])
    return text_lines(compact(c), 'dim', prefix=[when, (f'out {kind}: ', 'dim')])


def session_messages(s, limit=500):
    ins = sess_db(s, 'inbound.db', 'select seq, kind, timestamp, status, content from messages_in '
                                   'order by seq desc limit ?', (limit,))
    outs = sess_db(s, 'outbound.db', 'select seq, kind, timestamp, content from messages_out '
                                     'order by seq desc limit ?', (limit,))
    rows = [('in', r) for r in ins] + [('out', r) for r in outs]
    rows.sort(key=lambda x: (x[1].get('timestamp') or '', x[0] == 'out'))
    return rows


