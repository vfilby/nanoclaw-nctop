def dump(args):
    host = Host()
    host.refresh()
    what = args[0] if args else 'overview'
    verbose = '--verbose' in args
    out = []
    if what == 'overview':
        out = overview_lines(host)
    elif what == 'sessions':
        v = SessionsView(host)
        v.closed = '--closed' in args
        v.refresh()
        out = [L(' | '.join(c[0] for c in cells_)) for _, cells_, _ in v.table.rows]
    elif what == 'tasks':
        v = TasksView(host)
        v.all = '--all' in args
        v.refresh()
        out = [L(' | '.join(c[0] for c in cells_)) for _, cells_, _ in v.table.rows]
    elif what == 'logs':
        v = LogsView(host)
        v.refresh()
        out = v.pager.lines[-50:]
    elif what == 'files':
        v = FilesView(host, args[1] if len(args) > 1 and not args[1].startswith('-') else GROUPS_DIR)
        v.refresh()
        out = v.header() + [L(' | '.join(c[0] for c in cells_)) for _, cells_, _ in v.table.rows]
    elif what == 'file':
        out = file_lines(args[1])
    elif what == 'paths':
        out = [L(f'{k:15} {v}') for k, v in (('root', ROOT), ('slug', SLUG), ('systemd unit', SYSTEMD_UNIT),
                                             ('launchd label', LAUNCHD_LABEL), ('ncl', NCL), ('runtime', RUNTIME))]
        out += [L(f'container       {sid} {container_name(sid)}') for sid in args[1:]]
        out += [L(f'ncl call        {" ".join([resource, "list", *extra, "--json"])}')
                for resource, extra in {**Host.FAST, **Host.SLOW}.items()]
    elif what == 'session':
        s = [x for x in host.sessions() if x['id'] == args[1]]
        if not s:
            sys.exit(f'nctop: no session {args[1]}')
        v = SessionView(host, s[0], mode='messages' if '--messages' in args else None)
        v.verbose = verbose
        v.refresh()
        out = v.header() + v.pager.lines[-200:]
    else:
        sys.exit(f'nctop: unknown view {what!r}')
    for segs, _ in out:
        print(plain(segs))


def main():
    if sys.platform.startswith('linux') and os.path.isdir(f'/run/user/{os.getuid()}'):
        os.environ.setdefault('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')  # systemctl --user under sudo -u
    owner_hint()
    args = sys.argv[1:]
    if args and args[0] in ('-h', '--help'):
        with open(__file__) as f:
            for ln in f.read().split('\n')[1:]:
                if not ln.startswith('#'):
                    break
                print(ln[2:])
        return
    if args and args[0] == '--dump':
        dump(args[1:])
        return
    os.environ.setdefault('ESCDELAY', '25')
    curses.wrapper(main_curses)


if __name__ == '__main__':
    main()
