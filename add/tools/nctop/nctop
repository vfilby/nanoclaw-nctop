HELP = """nctop: read-only dashboard for NanoClaw v2

Anywhere
  1-5 / Tab / Shift-Tab   switch tab: Overview, Sessions, Tasks, Logs, Files
  q / Esc                 back; quit from a tab
  Q                       quit
  r                       refresh now (also re-runs systemctl, docker and ncl)
  ?                       this help

Lists                     j/k or arrows move, Space/b page, g/G top/bottom, Enter opens
Text                      j/k scroll, Space/b page, g/G top/bottom (G also resumes following),
                          f follow on/off, / search, n/N next/previous match

Sessions                  c includes closed sessions
Session                   t the agent's transcript (its Claude Code session: text, tool calls, results)
                          m the session's messages (what came in and what went out, host-side)
                          v verbose: whole messages, thinking, hooks, bookkeeping records
                          o browse the agent's folder, O browse the session folder (inbox, outbox)
Tasks                     a includes finished and cancelled tasks; Enter shows details and the run log;
                          s (in a task) follows its session
Logs                      e switches to the error log, w shows warnings and errors only
Files                     Enter/→ opens, ←/Backspace goes up, s sorts by name or by time (newest first)

Columns: ● run = a live container, ? run = the database says running but docker has none, ○ = stopped.
'last' is green under 15 minutes, yellow under 2 hours.

Nothing here changes anything: it reads through `ncl <resource> list --json`, opens the session
mailboxes read-only, and otherwise runs only the service manager's status and docker ps/stats.
"""


class HelpView(View):
    title, keys = 'Help', 'q back'

    def __init__(self, host):
        super().__init__(host)
        self.pager = Pager()
        self.pager.set(text_lines(HELP))

    def body(self):
        return self.pager


class App:
    def __init__(self, scr, host):
        self.scr, self.host = scr, host
        self.tabs = [OverviewView(host), SessionsView(host), TasksView(host), LogsView(host), FilesView(host)]
        self.tab = 0
        self.stack = []
        self.message = None

    def view(self):
        return self.stack[-1] if self.stack else self.tabs[self.tab]

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 6 or w < 30:
            put(scr, 0, 0, 'terminal too small')
            scr.refresh()
            return
        x = put(scr, 0, 0, ' nctop ', STYLE['bold'] | curses.A_REVERSE)
        for i, t in enumerate(self.tabs):
            attr = curses.A_REVERSE | STYLE['bold'] if i == self.tab and not self.stack else 0
            x = put(scr, 0, x + 1, f' {i + 1} {t.title} ', attr)
        for v in self.stack:
            x = put(scr, 0, x + 1, f'› {v.title}', STYLE['bold'] | (curses.A_REVERSE if v is self.stack[-1] else 0))
        sv = self.host.service or {}
        state = sv.get('ActiveState') or '…'
        right = f' {socket.gethostname()}  {state} '
        put(scr, 0, max(x + 2, w - width(right) - 1), right,
            STYLE['ok'] if state == 'active' else STYLE['bad'] if sv else STYLE['dim'])
        v = self.view()
        v.draw(scr, 1, h - 2, w)
        foot = self.message or f' {v.keys}  ? help  q {"back" if self.stack else "quit"}'
        put(scr, h - 1, 0, pad(foot, w - 1), STYLE['dim'] | curses.A_REVERSE)
        if self.host.refreshed and not self.message:
            stamp = time.strftime(' %H:%M:%S ', time.localtime(self.host.refreshed))
            put(scr, h - 1, w - len(stamp) - 1, stamp, curses.A_REVERSE)
        scr.refresh()

    def prompt(self, label):
        h, w = self.scr.getmaxyx()
        buf = ''
        self.scr.timeout(-1)
        curses.curs_set(1)
        try:
            while True:
                put(self.scr, h - 1, 0, pad(label + buf, w - 1), curses.A_REVERSE)
                self.scr.move(h - 1, min(w - 2, width(label + buf)))
                k = self.scr.get_wch()
                if k in ('\n', '\r') or k == curses.KEY_ENTER:
                    return buf
                if k == '\x1b':
                    return None
                if k in ('\x7f', '\b') or k == curses.KEY_BACKSPACE:
                    buf = buf[:-1]
                elif isinstance(k, str) and k.isprintable():
                    buf += k
        finally:
            try:
                curses.curs_set(0)
            except curses.error:
                pass
            self.scr.timeout(500)

    def handle(self, k):
        self.message = None
        v = self.view()
        if k == ord('Q'):
            return False
        if k in (ord('q'), 27):
            if self.stack:
                self.stack.pop()
                self.view().next = 0
                return True
            return k == 27  # Esc at a tab does nothing; q quits
        if k == ord('?'):
            self.stack.append(HelpView(self.host))
            return True
        if k == ord('r'):
            self.host.poke()
            v.next = 0
            for t in self.tabs:
                t.next = 0
            return True
        if k == ord('/'):
            term = self.prompt('search: ')
            if term:
                v.search(term)
            return True
        if ord('1') <= k <= ord('5'):
            self.stack, self.tab = [], k - ord('1')
            self.tabs[self.tab].next = 0
            return True
        if k in (9, curses.KEY_BTAB):
            self.stack = []
            self.tab = (self.tab + (1 if k == 9 else -1)) % len(self.tabs)
            self.tabs[self.tab].next = 0
            return True
        res = v.key(k)
        if isinstance(res, tuple) and res[0] == 'push':
            self.stack.append(res[1])
        elif res is False and k in BACK and self.stack:
            self.stack.pop()
        return True

    def loop(self):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        self.scr.timeout(500)
        self.scr.keypad(True)
        while True:
            for t in [self.view()]:
                try:
                    t.tick()
                except Exception as e:  # a view must not take the dashboard down; say what broke
                    self.message = f' {t.title}: {e!r}'
            self.draw()
            k = self.scr.getch()
            if k == -1:
                continue
            if k == curses.KEY_RESIZE:
                continue
            if self.handle(k) is False:
                return


def main_curses(scr):
    init_styles()
    host = Host()
    host.start()
    App(scr, host).loop()


