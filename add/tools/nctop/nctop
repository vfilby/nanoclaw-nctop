def tool_summary(name, inp, verbose):
    if not isinstance(inp, dict):
        return str(inp)
    if verbose:
        return compact(inp, drop=())
    for k in ('command', 'file_path', 'path', 'pattern', 'url', 'query', 'description', 'prompt', 'skill'):
        v = inp.get(k)
        if isinstance(v, str) and v:
            extra = f'  ({inp["description"]})' if k == 'command' and inp.get('description') else ''
            return trunc(v.split('\n')[0], 200) + extra
    return trunc(compact(inp), 200)


def result_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        out = []
        for x in content:
            if isinstance(x, dict):
                out.append(x.get('text') if x.get('type') == 'text' else f'[{x.get("type")}]')
        return '\n'.join(o for o in out if o)
    return compact(content)


def transcript_lines(o, verbose=False):
    """One transcript record as display lines (none for bookkeeping records unless verbose)."""
    t = o.get('type')
    when = (local(parse_ts(o.get('timestamp')), '%H:%M:%S') + ' ' if o.get('timestamp') else ' ' * 9, 'dim')
    side = [('  ⤷ ', 'accent')] if o.get('isSidechain') else []
    pre = [when, *side]
    out = []
    if t in ('user', 'assistant'):
        content = (o.get('message') or {}).get('content')
        items = [{'type': 'text', 'text': content}] if isinstance(content, str) else (content or [])
        for x in items:
            if not isinstance(x, dict):
                continue
            k = x.get('type')
            if t == 'user' and k == 'text':
                body, more = (x.get('text') or '', 0) if verbose else last_lines(x.get('text') or '', 8)
                if more:
                    out += [L(when, *side, (f'» … {more} earlier lines (v shows all)', 'dim'))]
                out += text_lines(body, 'user', prefix=pre + [('» ', 'user')])
            elif t == 'user' and k == 'tool_result':
                body = result_text(x.get('content'))
                body, more = first_lines(body, 40 if verbose else 2)
                style = 'bad' if x.get('is_error') else 'dim'
                out += text_lines(body + (f'\n… +{more} lines' if more else ''), style, prefix=pre + [('  ⎿ ', style)])
            elif k == 'text':
                out += text_lines(x.get('text') or '', None, prefix=pre + [('● ', 'ok')])
            elif k == 'tool_use':
                out += text_lines(tool_summary(x.get('name'), x.get('input'), verbose), None,
                                  prefix=pre + [(f'⚙ {short_tool(x.get("name"))} ', 'tool')])
            elif k == 'thinking':
                if verbose and x.get('thinking'):
                    out += text_lines(x['thinking'], 'dim', prefix=pre + [('∴ ', 'dim')])
            elif k == 'image':
                out += [L(*pre, ('[image]', 'dim'))]
            elif verbose:
                out += [L(*pre, (f'[{k}]', 'dim'))]
        return out
    if t == 'system':
        sub = o.get('subtype')
        if sub == 'compact_boundary':
            return [L(*pre, ('──── conversation compacted ────', 'warn'))]
        if o.get('level') == 'error' or 'error' in (sub or ''):
            return text_lines(o.get('content') or sub or 'error', 'bad', prefix=pre + [('! ', 'bad')])
        return [L(*pre, (f'[{sub}]', 'dim'))] if verbose else []
    if t == 'attachment':
        a = o.get('attachment') or {}
        if a.get('type') == 'queued_command':
            body, more = (a.get('prompt') or '', 0) if verbose else last_lines(str(a.get('prompt') or ''), 4)
            return text_lines(body, 'user', prefix=pre + [('» (while busy) ', 'user')])
        if a.get('type') == 'hook_success' and verbose:
            return text_lines(first_lines(a.get('content') or '', 3)[0], 'dim',
                              prefix=pre + [(f'[hook {a.get("hookName")}] ', 'dim')])
        return [L(*pre, (f'[{a.get("type")}]', 'dim'))] if verbose else []
    if t == 'ai-title':  # rewritten every turn; the sessions list shows the latest
        return [L(*pre, ('title: ', 'dim'), (o.get('aiTitle') or '', 'accent'))] if verbose else []
    return [L(*pre, (f'[{t}]', 'dim'))] if verbose else []


class Tail:
    """Reads a growing file incrementally; starts at its tail and notices truncation and rotation."""

    def __init__(self, path, start_tail):
        self.path, self.start_tail = path, start_tail
        self.ino = self.pos = None
        self.partial = b''

    def read(self):
        """New complete lines since the last call, and whether the file was replaced (the caller starts over)."""
        try:
            st = os.stat(self.path)
        except OSError:
            return [], False
        reset = False
        if self.ino != st.st_ino or st.st_size < (self.pos or 0):
            reset = self.ino is not None
            self.ino, self.pos, self.partial = st.st_ino, max(0, st.st_size - self.start_tail), b''
            skip_first = self.pos > 0
        else:
            skip_first = False
        if st.st_size == self.pos:
            return [], reset
        with open(self.path, 'rb') as f:
            f.seek(self.pos)
            chunk = f.read()
        self.pos += len(chunk)
        data = self.partial + chunk
        lines = data.split(b'\n')
        self.partial = lines.pop()
        if skip_first and lines:
            lines.pop(0)
        return [ln.decode('utf-8', 'replace') for ln in lines], reset


