    head = lambda s: out.append(L((s, 'head')))

    sv = host.service
    if sv is None:
        out.append(L(('Service  ', 'bold'), ('checking…', 'dim')))
    elif sv.get('missing'):
        out.append(L(('Service  ', 'bold'), (f"no service {sv['unit']} for this checkout (has setup run?)", 'bad')))
    else:
        state = f"{sv.get('ActiveState', '?')} ({sv.get('SubState', '?')})"
        segs = [('Service  ', 'bold'), (sv['unit'] + '  ', None),
                (state, 'ok' if sv.get('ActiveState') == 'active' else 'bad')]
        since = sv.get('ActiveEnterTimestamp', '')
        if since.startswith('@'):
            t = dt.datetime.fromtimestamp(int(since[1:]), dt.timezone.utc)
            segs.append((f'  since {local(t)} ({ago(t)})', None))
        if sv.get('MainPID') not in (None, '', '0'):
            segs.append((f'  pid {sv["MainPID"]}', 'dim'))
        if sv.get('MemoryCurrent', '').isdigit():
            segs.append((f'  mem {human_bytes(sv["MemoryCurrent"])}', 'dim'))
        if sv.get('NRestarts') not in (None, '', '0'):
            segs.append((f'  restarts {sv["NRestarts"]}', 'warn'))
        out.append(L(*segs))

    hs = host_stats()
    segs = [('Host     ', 'bold'), (hs['name'], None)]
    if 'uptime' in hs:
        segs.append((f'  up {span(hs["uptime"])}', None))
    if 'load' in hs:
        segs.append(('  load ' + ' '.join(hs['load']), 'warn' if float(hs['load'][0]) > (os.cpu_count() or 1) else None))
    if 'mem' in hs:
        used, total = hs['mem']
        segs.append((f'  mem {human_bytes(used)}/{human_bytes(total)}', 'warn' if used > 0.9 * total else None))
    if 'disk' in hs:
        used, total = hs['disk']
        segs.append((f'  disk {human_bytes(used)}/{human_bytes(total)}', 'bad' if used > 0.9 * total else None))
    out.append(L(*segs))

    others = [c for c in (host.containers or []) if not c.get('Names', '').startswith(CONTAINER_PREFIX)]
    if others:
        segs = [('Other    ', 'bold')]
        for c in others:
            status = c.get('Status', '')
            style = 'bad' if 'unhealthy' in status or not status.startswith('Up') else \
                'ok' if 'healthy' in status else None
            segs += [(c.get('Names', '?'), style), ('  ', None)]
        out.append(L(*segs))
    elif host.containers is None and host.refreshed:
        out.append(L(('Other    ', 'bold'), (f'{RUNTIME} ps failed (see Problems)', 'bad')))

    rows = session_rows(host)
    groups = host.groups()
    out.append(L(''))
    head('Agents')
    for gid, g in groups.items():
        mine = [r for r in rows if r['s']['agent_group_id'] == gid]
        running = sum(1 for r in mine if r['container'])
        last = max((r['last'] for r in mine if r['last']), default=None)
        said = ''
        for r in mine:
            m = sess_db(r['s'], 'outbound.db', "select content from messages_out where kind = 'chat' "
                                               'order by seq desc limit 1')
            if m:
                c = loads(m[0]['content'])
                said = c.get('text', '') if isinstance(c, dict) else str(c)
                break
        out.append(L('  ', (pad(g['name'], 8), 'bold'), pad(g['folder'], 15),
                     (pad(f'{running} running', 11), 'ok' if running else 'dim'),
                     pad(f'{len(mine)} sessions', 13), ('last ', 'dim'), (pad(ago(last), 8), fresh(last)),
                     (f'"{trunc(said, 120)}"' if said else '', 'dim')))

    out.append(L(''))
    live = [r for r in rows if r['container'] or r['st'].get('current_tool')]
    head(f'Running sessions ({len(live)})')
    if not live:
        out.append(L(('  none', 'dim')))
    for r in live:
        stats = host.stats.get((r['container'] or {}).get('Names'), {})
        out.append(L('  ', container_cell(r), ' ', (pad(r['agent'], 7), 'bold'), pad(r['where'], 22),
                     (pad(tool_cell(r), 18), 'tool'), ('last ', 'dim'), (pad(ago(r['last']), 7), fresh(r['last'])),
                     (pad(f"{stats.get('CPUPerc', '')} {stats.get('MemUsage', '').split(' /')[0]}", 18), 'dim'),
                     (r['title'], 'accent')))

    out.append(L(''))
    head('Attention')
    approvals, dropped = host.approvals(), host.dropped()
    for a in approvals:
        out.append(L('  ', ('approval ', 'warn'), f"{a.get('action')}: {a.get('title') or a.get('question') or ''}",
                     (f"  {ago(parse_ts(a.get('created_at')))} ago", 'dim')))
    for d in dropped[:8]:
        out.append(L('  ', ('dropped ', 'warn'), f"{d.get('message_count')} from {d.get('sender_name') or d.get('user_id') or '?'}"
                     f" on {d.get('platform_id')}: {d.get('reason')}", (f"  last {ago(parse_ts(d.get('last_seen')))} ago", 'dim')))
    stuck = []
    week = now_utc() - dt.timedelta(days=7)
    for r in rows:
        if (r['last'] or week) < week:
            continue
        for m in sess_db(r['s'], 'inbound.db', "select kind, status, tries, timestamp from messages_in "
                                               "where status = 'failed' or tries > 2 order by seq desc limit 3"):
            stuck.append((r, m))
    for r, m in stuck[:8]:
        out.append(L('  ', ('inbound ', 'bad'), f"{m['kind']} {m['status']} tries={m['tries']}  ",
                     (f"{r['agent']} {r['where']}  {ago(parse_ts(m['timestamp']))} ago", 'dim')))
    elog = os.path.join(LOG_DIR, 'nanoclaw.error.log')
    try:
        mt = dt.datetime.fromtimestamp(os.path.getmtime(elog), dt.timezone.utc)
        with open(elog, 'rb') as f:
            f.seek(max(0, os.path.getsize(elog) - 16384))
            tail = [clean(x) for x in f.read().decode('utf-8', 'replace').splitlines() if x.strip()][-3:]
        recent = (now_utc() - mt).total_seconds() < 3600
        out.append(L('  ', ('error log ', 'bad' if recent else 'dim'), (f'written {ago(mt)} ago', 'bad' if recent else 'dim')))
        for x in tail:
            out.append(L('    ', (trunc(x, 400), 'dim')))
    except OSError:
        pass
    if not (approvals or dropped or stuck):
        out.append(L(('  no pending approvals, dropped messages (24h) or stuck inbound messages', 'dim')))

    out.append(L(''))
    tasks = host.tasks
    head('Next tasks')
    if tasks is None:
        out.append(L(('  loading… (or ncl failed: see Problems)', 'dim')))
    else:
        upcoming = sorted((t for t in tasks if t.get('status') in ('pending', 'paused')),
                          key=lambda t: t.get('next_run') or t.get('process_after') or '~')
        for t in upcoming[:6]:
            nxt = parse_ts(t.get('next_run') or t.get('process_after'))
            out.append(L('  ', pad(ago(nxt), 10), (pad(groups.get(t.get('agent_group_id'), {}).get('name', '?'), 8), 'bold'),
                         pad(t.get('series_id') or t.get('row_id') or '', 34), (pad(t.get('schedule') or 'once', 14), 'dim'),
                         ('paused' if t.get('status') == 'paused' else '', 'warn'),
                         (f"failed {t['failed_runs']}" if t.get('failed_runs') else '', 'bad')))
        if not upcoming:
            out.append(L(('  none scheduled', 'dim')))

    if PROBLEMS:
        out.append(L(''))
        head('Problems')
        for p in list(PROBLEMS.values())[:10]:
            out.append(L('  ', (trunc(p, 300), 'bad')))
    return out


