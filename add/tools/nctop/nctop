class SessionView(View):
    keys = 't transcript  m messages  v verbose  f follow  / search  o agent folder  O session folder'
    every = 1.0

    def __init__(self, host, s, mode=None):
        super().__init__(host)
        self.s = s
        self.verbose = False
        self.st = sess_state(s)
        self.mode = mode or ('transcript' if transcript_path(s, self.st) else 'messages')
        self.reset()

    @property
    def title(self):
        return 'Session'

    def reset(self):
        self.pager = Pager(follow=True)
        self.tail = None
        self.tpath = None
        self.seen = None

    def refresh(self):
        fresh_rows = [r for r in self.host.sessions() if r['id'] == self.s['id']]
        if fresh_rows:
            self.s = fresh_rows[0]
        self.st = sess_state(self.s)
        if self.mode == 'transcript':
            path = transcript_path(self.s, self.st)
            if path != self.tpath:  # first open, or the agent started a new Claude session (/clear, compaction)
                if self.tpath:
                    self.pager.append([L(('──── new transcript ────', 'warn'))])
                self.tpath, self.tail = path, Tail(path, MAX_TRANSCRIPT) if path else None
            if not self.tail:
                if not self.pager.lines:
                    self.pager.set([L(('no Claude transcript for this session (m shows its messages)', 'dim'))])
                return
            lines, replaced = self.tail.read()
            if replaced:
                self.pager.set([])
            new = []
            for ln in lines:
                try:
                    o = json.loads(ln)
                except ValueError:
                    continue
                new += transcript_lines(o, self.verbose)
            self.pager.append(new)
        else:
            rows = session_messages(self.s)
            sig = (len(rows), rows[-1][1].get('timestamp') if rows else None, self.verbose)
            if sig != self.seen:
                self.seen = sig
                lines = []
                for direction, r in rows:
                    lines += message_lines(direction, r, self.verbose)
                self.pager.set(lines or [L(('no messages', 'dim'))])

    def header(self):
        groups = self.host.groups()
        g = groups.get(self.s['agent_group_id'], {})
        mgs, dms = self.host.messaging_groups(), self.host.dm_names()
        live = session_containers(self.host.containers).get(container_name(self.s['id']))
        r = {'s': self.s, 'st': self.st, 'container': live}
        last = parse_ts(self.s.get('last_active'))
        tool = tool_cell(r)
        mode = [(f' {m} ', 'bold' if m == self.mode else 'dim') for m in ('transcript', 'messages')]
        return [
            L((g.get('name') or '?', 'bold'), '  ', where(self.s, mgs, dms), '  ', (self.s['id'], 'dim'),
              '  ', container_cell(r), '  ', ('last ', 'dim'), (ago(last), fresh(last)),
              *(('  ', None), (tool, 'tool')) if tool else ()),
            L(*mode, ('  verbose' if self.verbose else '', 'warn'),
              ('  following' if self.pager.follow else '  paused (G or f to follow)', 'ok' if self.pager.follow else 'warn'),
              (f'  {os.path.basename(self.tpath)}' if self.mode == 'transcript' and self.tpath else '', 'dim')),
        ]

    def body(self):
        return self.pager

    def key(self, k):
        if k in (ord('t'), ord('m')):
            mode = 'transcript' if k == ord('t') else 'messages'
            if mode != self.mode:
                self.mode = mode
                self.reset()
                self.next = 0
            return True
        if k == ord('v'):
            self.verbose = not self.verbose
            self.reset()
            self.next = 0
            return True
        if k == ord('o'):
            g = self.host.groups().get(self.s['agent_group_id'], {})
            if g.get('folder'):
                return ('push', FilesView(self.host, os.path.join(GROUPS_DIR, g['folder'])))
        if k == ord('O'):
            return ('push', FilesView(self.host, sess_dir(self.s)))
        return self.pager.key(k)


